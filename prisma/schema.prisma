generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  location    String
  latitude    Float?
  longitude   Float?
  description String?
  source      String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
